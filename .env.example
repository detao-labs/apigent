# ═══════════════════════════════════════════════════════════════════
# Apigent — Environment Variables (SECRETS ONLY)
# ═══════════════════════════════════════════════════════════════════
# Copy to .env and fill in your secrets:
#   cp .env.example .env
#
# ⚠️  This file contains ONLY secrets (API keys, passwords, tokens).
#     Scheme choices (which provider, which model, which strategy)
#     belong in apigent.config.yaml — see apigent.config.example.yaml
#
# Naming: APIGENT_<CATEGORY>_<KEY> — consistent across all envs
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# Database — connection URL (provider choice is in .yaml)
# ───────────────────────────────────────────────────────────────────
APIGENT_DATABASE_URL=postgresql://apigent:apigent@localhost:5432/apigent_dev

# ───────────────────────────────────────────────────────────────────
# LLM — API keys (provider choice is in .yaml)
# ───────────────────────────────────────────────────────────────────
# Alibaba Cloud Model Studio (Qwen) — default provider
# https://bailian.console.aliyun.com/  (get your API key from the console)
# Also used by the qwen embedding (text-embedding-v4) and reranker (qwen3-rerank)
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (GPT)
# OPENAI_API_KEY=sk-your-key-here

# Google (Gemini)
# GEMINI_API_KEY=your-key-here

# ───────────────────────────────────────────────────────────────────
# Embedding — API keys (provider choice is in .yaml)
# ───────────────────────────────────────────────────────────────────
# Cohere (if using Cohere embedding or reranker)
# APIGENT_COHERE_API_KEY=your-key-here

# ───────────────────────────────────────────────────────────────────
# Vector Store — connection secrets (provider choice is in .yaml)
# ───────────────────────────────────────────────────────────────────
# Milvus
# APIGENT_MILVUS_USER=
# APIGENT_MILVUS_PASSWORD=

# Qdrant
# APIGENT_QDRANT_API_KEY=

# Weaviate
# APIGENT_WEAVIATE_API_KEY=

# Pinecone
# APIGENT_PINECONE_API_KEY=

# ───────────────────────────────────────────────────────────────────
# Queue / Redis — connection URL (provider choice is in .yaml)
# ───────────────────────────────────────────────────────────────────
APIGENT_REDIS_URL=redis://localhost:6379

# RabbitMQ (if using instead of BullMQ)
# APIGENT_RABBITMQ_URL=amqp://localhost:5672

# ───────────────────────────────────────────────────────────────────
# Storage — S3/MinIO credentials (provider choice is in .yaml)
# ───────────────────────────────────────────────────────────────────
# APIGENT_STORAGE_S3_ACCESS_KEY_ID=
# APIGENT_STORAGE_S3_SECRET_ACCESS_KEY=

# ───────────────────────────────────────────────────────────────────
# Auth — secrets & OAuth credentials
# ───────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
APIGENT_AUTH_SECRET=change-me-to-a-random-string

# GitHub OAuth
# APIGENT_AUTH_GITHUB_ID=
# APIGENT_AUTH_GITHUB_SECRET=

# Google OAuth
# APIGENT_AUTH_GOOGLE_ID=
# APIGENT_AUTH_GOOGLE_SECRET=

# ───────────────────────────────────────────────────────────────────
# Server
# ───────────────────────────────────────────────────────────────────
NODE_ENV=development
