{
  "name": "@apigent/server",
  "version": "0.1.0",
  "private": true,
  "description": "Apigent server layer — database access, repositories, and domain services",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./id": "./src/id.ts",
    "./logging": "./src/logging/index.ts",
    "./auth": "./src/auth/index.ts",
    "./authz": "./src/authz/index.ts",
    "./openapi": "./src/openapi/index.ts",
    "./queue": "./src/queue/index.ts",
    "./imports": "./src/imports/index.ts",
    "./notifications": "./src/notifications/index.ts",
    "./contexts": "./src/contexts/index.ts",
    "./ai": "./src/ai/model.ts",
    "./versions": "./src/versions/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "vitest run",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@apigent/core": "workspace:*",
    "ai": "^7.0.62",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
